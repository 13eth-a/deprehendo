{
  "name": "deprehendo-web",
  "version": "0.0.0",
  "private": true,
  "description": "deprehendo Cloud dashboard (Phase 7). Renders stored runopsy.analysis documents; never diagnoses.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "auth:smoke": "node --env-file=../.env.local --import tsx scripts/auth-smoke.ts"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
