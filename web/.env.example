# Copy to web/.env.local (gitignored) for local runs; set the same names as
# Railway variables for the dashboard service. Never commit real values.

# Neon managed Better Auth URL (written to ../.env.local by `neon deploy`).
NEON_AUTH_BASE_URL=
# 32+ random characters for session cookies: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# The Deprehendo API this dashboard reads from, server-side only.
DEPREHENDO_API_URL=http://127.0.0.1:6080
# Set to 1 once GitHub OAuth is configured in Neon Auth to show the button.
NEXT_PUBLIC_AUTH_GITHUB=0
